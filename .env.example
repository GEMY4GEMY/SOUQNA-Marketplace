# Public app configuration
NEXT_PUBLIC_APP_NAME=SOUQNA
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_COUNTRY=EG
NEXT_PUBLIC_DEFAULT_GOVERNORATE=Fayoum

# Server-only placeholders — never commit real values
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/souqna
AUTH_SECRET=replace-with-a-long-random-secret
STORAGE_PROVIDER=local

# One-time SUPER_OWNER bootstrap. Set only in a protected server environment,
# run npm run owner:bootstrap once, then disable/remove these values.
BOOTSTRAP_OWNER_ENABLED=false
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PHONE=
BOOTSTRAP_OWNER_PASSWORD=
