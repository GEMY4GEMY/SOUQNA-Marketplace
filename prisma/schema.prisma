generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_OWNER
  ADMIN
  MODERATOR
  SUPPORT
  BUSINESS
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum AdStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  SOLD
  EXPIRED
  ARCHIVED
}

model User {
  id           String      @id @default(cuid())
  name         String
  phone        String?     @unique
  email        String?     @unique
  passwordHash String?
  role         UserRole    @default(USER)
  status       UserStatus  @default(ACTIVE)
  ads          Ad[]
  images       AdImage[]
  auditEvents  AuditLog[]  @relation("AuditActor")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([role, status])
}

model Governorate {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  slug      String   @unique
  active    Boolean  @default(true)
  areas     Area[]
  ads       Ad[]
  createdAt DateTime @default(now())
}

model Area {
  id            String      @id @default(cuid())
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  nameAr        String
  nameEn        String
  slug          String
  active        Boolean     @default(true)
  ads           Ad[]
  createdAt     DateTime    @default(now())

  @@unique([governorateId, slug])
}

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  nameAr    String
  nameEn    String
  slug      String     @unique
  active    Boolean    @default(true)
  ads       Ad[]
  createdAt DateTime   @default(now())
}

model Ad {
  id            String      @id @default(cuid())
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id])
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id])
  areaId        String?
  area          Area?       @relation(fields: [areaId], references: [id])
  title         String
  description   String
  price         Decimal?    @db.Decimal(12, 2)
  status        AdStatus    @default(PENDING)
  featured      Boolean     @default(false)
  attributes    Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  images        AdImage[]

  @@index([status, governorateId, categoryId])
  @@index([ownerId, status])
}

model AdImage {
  id        String   @id @default(cuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader  User     @relation(fields: [uploaderId], references: [id])
  storageKey String  @unique
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([adId, position])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
